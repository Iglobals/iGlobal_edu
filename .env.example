# Flask Configuration
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@host/dbname

# MongoDB - book/chapter/page CONTENT only (see mongo_books.py). Book
# metadata stays in Postgres above.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/iglobals_edu

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# ICA centralized Paystack webhook relay (see ica_webhook_routes.py). Get
# this from the ICA admin panel: Settings > Clients > this app > Payment
# webhooks, after registering this app's webhook URL there:
#   <your base url>/api/webhooks/ica-relay/paystack
ICA_WEBHOOK_RELAY_SECRET=change-me

# StudyNeat partner SSO - on-demand "Use AI Deep Dive" handoff (see studyneat_client.py).
# Add your real values directly to .env, not here.
STUDYNEAT_API_BASE_URL=https://api.studyneat.xyz
STUDYNEAT_CLIENT_KEY=iglobal_key_...
STUDYNEAT_CLIENT_SECRET=change-me

# iGlobals Central Auth (ICA) — replaces native login/signup/password reset
ICA_BASE_URL=https://auth.iglobals.com
ICA_CLIENT_ID=your-ica-client-id
ICA_CLIENT_SECRET=your-ica-client-secret
ICA_REDIRECT_URI=http://localhost:5000/auth/callback

# Redis (optional) — used to hold OAuth PKCE state across the ICA redirect.
# Falls back to in-process memory if unset, which is fine for local dev but
# not reliable across multiple serverless function instances in production.
REDIS_URL=redis://localhost:6379/0

# Cloudinary (for image hosting)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
